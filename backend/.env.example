PORT=3001

# Ollama - AI locale gratuita
# Scarica da: https://ollama.com
# Dopo l'installazione esegui: ollama pull mistral
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=mistral

# Tor - per scansionare siti .onion
# Scarica Tor Browser o Tor Expert Bundle da: https://www.torproject.org
# Il proxy SOCKS5 di Tor gira di default su 127.0.0.1:9050
# Tor Browser usa 9150 (default), il servizio Tor standalone usa 9050
TOR_PROXY=socks5://127.0.0.1:9150
