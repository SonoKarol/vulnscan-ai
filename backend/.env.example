# ── Server ──────────────────────────────────────────────────────────────────
PORT=3001
# Di default il backend ascolta solo in locale: lo scanner fa richieste
# server-side, non esporlo in rete senza autenticazione.
HOST=127.0.0.1

# Consenti la scansione di indirizzi interni (localhost, 192.168.x.x, …), ad
# esempio per testare il tuo server di sviluppo. Disattivato di default: con
# il backend esposto in rete permetterebbe attacchi SSRF.
ALLOW_PRIVATE_TARGETS=false

# ── Modello AI opzionale (node-llama-cpp) ───────────────────────────────────
# Non serve: senza modello l'analisi usa l'analista integrato (istantaneo).
# Se scarichi un modello (dalla UI o con `npm run model:download`) gira dentro
# il processo Node e viene usato al posto dell'analista. Nessun download
# avviene automaticamente. false = usa sempre l'analista integrato.
AI_ENABLED=true

# Preset disponibili:
#   leggero    → Qwen 3.5 0.8B  (~1 GB,  PC modesti, analisi essenziale)
#   bilanciato → Qwen 3.5 4B    (~3 GB,  consigliato)
#   accurato   → Qwen 3.5 9B    (~6 GB,  serve GPU o molta RAM)
# Oppure un URI Hugging Face (es. hf:giladgd/gemma-4-E4B-it-GGUF:Q4_K_M)
# o il percorso di un file .gguf locale.
AI_MODEL=bilanciato

# Cartella dove salvare i modelli (relativa a backend/)
AI_MODELS_DIR=./models

# Carica il modello all'avvio, solo se è già stato scaricato
AI_AUTOLOAD=true

# Accelerazione: auto | cuda | vulkan | metal | false (solo CPU)
AI_GPU=auto

# Dimensione del contesto (token)
AI_CONTEXT_SIZE=8192

# ── Tor (opzionale, per siti .onion) ────────────────────────────────────────
# Tor Browser espone SOCKS5 su 9150, il servizio tor standalone su 9050.
# Usa socks5h:// così la risoluzione dei nomi .onion avviene dentro Tor.
TOR_PROXY=socks5h://127.0.0.1:9150
